{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wobbly Guide",
  "version": "2.0.0",
  "identifier": "dev.wobbly-guide.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Wobbly Guide","width":1280,"height":850,"minWidth":320,"minHeight":480}],
    "security": {"csp":"default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/icon.ico"],"shortDescription":"Unofficial Wobbly Life companion"}
}
